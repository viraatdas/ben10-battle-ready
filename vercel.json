{
  "buildCommand": null,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/game/:file.dcr",
      "headers": [
        { "key": "Content-Type", "value": "application/x-director" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/game/:file.dxr",
      "headers": [
        { "key": "Content-Type", "value": "application/x-director" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/game/:file.dir",
      "headers": [
        { "key": "Content-Type", "value": "application/x-director" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/game/:file.cct",
      "headers": [
        { "key": "Content-Type", "value": "application/x-director" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/game/:file.cst",
      "headers": [
        { "key": "Content-Type", "value": "application/x-director" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/game/:file.swf",
      "headers": [
        { "key": "Content-Type", "value": "application/x-shockwave-flash" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/dirplayer-polyfill.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/ruffle/:file.wasm",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
